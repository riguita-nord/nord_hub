# Copy to .env, then replace both required values with unique secrets.
POSTGRES_DB=nord_hub
POSTGRES_USER=nord_hub
POSTGRES_PASSWORD=replace-with-a-unique-database-password
NORD_HUB_JWT_SECRET=replace-with-at-least-32-random-bytes
NORD_HUB_ADMIN_EMAILS=you@example.com
NORD_HUB_SETUP_TOKEN=replace-with-a-random-32-byte-token
NORD_HUB_GITHUB_TOKEN=
NORD_HUB_GITHUB_API_URL=https://api.github.com
NORD_HUB_GITHUB_WEBHOOK_SECRET=
NORD_HUB_AI_API_KEY=
NORD_HUB_AI_BASE_URL=https://api.openai.com/v1
NORD_HUB_AI_MODEL=gpt-4o-mini
NORD_HUB_NORD_SAAS_URL=
NORD_HUB_NORD_SAAS_SESSION_TOKEN=
NORD_HUB_WEB_PORT=8080
# Keep local-only by default; use 0.0.0.0 only behind trusted firewall/TLS proxy.
NORD_HUB_BIND_ADDRESS=127.0.0.1
NORD_HUB_CORS_ORIGINS=http://localhost:8080
